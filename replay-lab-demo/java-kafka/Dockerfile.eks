FROM amazoncorretto:17-alpine
ARG JAR_PATH
COPY ${JAR_PATH} /app/service.jar
COPY replay-lab-demo/java-kafka/output/tools/proxymock-linux-amd64 /usr/local/bin/proxymock
RUN chmod 755 /usr/local/bin/proxymock && adduser -D -u 1001 demo && mkdir /work && chown demo /work
USER 1001
WORKDIR /work
ENTRYPOINT ["java", "-Duser.timezone=UTC", "-jar", "/app/service.jar"]
