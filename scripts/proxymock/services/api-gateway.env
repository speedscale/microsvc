# Per-service config for the shared proxymock replay harness (scripts/proxymock/replay-service.sh).
# Sourced as bash. Keep this to declarations only.

# Service location and app port.
SERVICE_DIR_REL="backend/api-gateway"
APP_PORT=8080

# How the app is built and launched. JAR_GLOB is resolved under $SERVICE_DIR.
BUILD_CMD="./mvnw -q clean package -DskipTests"
JAR_GLOB="target/api-gateway-*.jar"

# Health endpoints probed (in order) until one returns 200. Do NOT use a gateway self-route
# (e.g. /api/healthz) that passes through the now-proxied http client.
HEALTH_PATHS=("/actuator/health" "/health")

# Downstream dependency dirs in the golden snapshot that proxymock mock should serve
# (everything the app calls out to). The inbound set is recorded-golden/localhost.
DOWNSTREAM_DIRS=(banking-user banking-accounts banking-transactions)

# Env the app is started with. The app keeps the RECORDED downstream hostnames as its
# service URLs; its http client is routed through proxymock mock on 127.0.0.1:4140.
APP_ENV=(
  "JWT_SECRET=${PROXYMOCK_JWT_SECRET}"          # set by the harness to the golden test key
  "USER_SERVICE_URL=http://banking-user:80"
  "ACCOUNTS_SERVICE_URL=http://banking-accounts:80"
  "TRANSACTIONS_SERVICE_URL=http://banking-transactions:80"
)

# JVM/app flags for a deterministic offline run:
#  - disable the Redis-backed rate limiter (no Redis needed)
#  - pin the random fault-injection filter off
#  - route the gateway's outbound http client through proxymock mock (:4140)
#  - turn OTel off and exclude the OTel starter autoconfigs that crash startup offline
APP_FLAGS=(
  "-Dgateway.rate-limiter.enabled=false"
  "-Dfault.injection.rate=0.0"
  "-Dspring.cloud.gateway.httpclient.proxy.host=127.0.0.1"
  "-Dspring.cloud.gateway.httpclient.proxy.port=4140"
  "-Dotel.traces.exporter=none"
  "-Dotel.metrics.exporter=none"
  "-Dotel.logs.exporter=none"
  "-Dotel.sdk.disabled=true"
  "-Dspring.autoconfigure.exclude=io.opentelemetry.instrumentation.spring.autoconfigure.OpenTelemetryAutoConfiguration,io.opentelemetry.instrumentation.spring.autoconfigure.instrumentation.web.SpringWebInstrumentationAutoConfiguration,io.opentelemetry.instrumentation.spring.autoconfigure.instrumentation.webflux.SpringWebfluxInstrumentationAutoConfiguration"
)

# Known-gap rules passed to prepare_golden.py when rebuilding the golden (documentation /
# reproducibility; the harness itself does not re-run prepare). See the skill.
KNOWN_GAP_PATTERNS=("http:queryparams:accountId is")
KNOWN_GAP_STATUS=("/api/transactions:503")
