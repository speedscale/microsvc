{
  "id": "readiness-demo-regression",
  "generator": {
    "stages": [
      {
        "virtualUsers": {
          "virtualUsers": "1",
          "requestDelay": {}
        }
      }
    ],
    "evaluationIntervals": 5
  },
  "rules": [
    {
      "metricName": "passAssertPct",
      "type": "TOO_LOW",
      "value": 90,
      "action": "ALERT"
    },
    {
      "metricName": "p95",
      "value": 2000,
      "action": "ALERT"
    }
  ],
  "assertionGroups": [
    {
      "configs": [
        {
          "type": "httpStatusCode"
        },
        {
          "type": "httpResponseBody",
          "config": {
            "ignore": "durationMs"
          }
        }
      ]
    }
  ],
  "responder": {
    "numReplicas": 1,
    "responseDelay": {}
  },
  "cluster": {
    "cleanup": "inventory",
    "replayMode": "full-replay",
    "sidecarTlsOut": true,
    "logLevel": "info",
    "logsCollected": true,
    "generatorResources": {
      "limits": {
        "cpu": "1",
        "memory": "2147483648"
      },
      "requests": {
        "cpu": "100m",
        "memory": "134217728"
      }
    },
    "responderResources": {
      "limits": {
        "cpu": "500m",
        "memory": "1073741824"
      },
      "requests": {
        "cpu": "100m",
        "memory": "134217728"
      }
    }
  },
  "readiness": {
    "families": []
  }
}
